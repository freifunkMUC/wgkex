# Copy or rename this file to .env and modify if for your needs

# Image tag from ghcr.io/freifunkmuc/wgkex: "main" (latest main build), "sha-<short sha>" or a release tag like "v0.2.1"
#WGKEX_IMAGE_TAG="main"

#WGKEX_DOMAINS="ffmuc_muc_cty, ffmuc_muc_nord, ffmuc_muc_ost, ffmuc_muc_sued, ffmuc_muc_west, ffmuc_welt, ffwert_city"
#WGKEX_DOMAIN_PREFIXES="ffmuc_, ffdon_, ffwert_"
#WGKEX_DEBUG="DEBUG"
#WGKEX_BROKER_LISTEN_HOST="0.0.0.0"
#WGKEX_BROKER_LISTEN_PORT="5000"

#MQTT_BROKER_URL="mqtt"
#MQTT_BROKER_PORT="1883"
#MQTT_USERNAME=""
#MQTT_PASSWORD=""
#MQTT_KEEPALIVE="5"
#MQTT_TLS="False"
