    {
      "type": "state-timeline",
      "title": "Worker state",
      "id": 5,
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "offline",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "online",
                  "color": "green",
                  "index": 1
                },
                "2": {
                  "text": "draining",
                  "color": "orange",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "query": "SELECT last(\"wgkex_broker_worker_online\") + last(\"wgkex_broker_worker_draining\") FROM \"prometheus\" WHERE \"worker\" =~ /^$worker$/ AND $timeFilter GROUP BY time($__interval), \"worker\" fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_worker"
        }
