{
  "title": "wgkex (InfluxDB)",
  "uid": "wgkex-influx",
  "description": "wgkex broker load balancing and worker metrics, see https://github.com/freifunkMUC/wgkex",
  "tags": [
    "wgkex",
    "freifunk"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "DS",
        "label": "Data source",
        "query": "influxdb",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": ""
      },
      {
        "type": "query",
        "name": "worker",
        "label": "Worker",
        "datasource": {
          "type": "influxdb",
          "uid": "${DS}"
        },
        "query": "SHOW TAG VALUES FROM \"prometheus\" WITH KEY = \"worker\"",
        "definition": "SHOW TAG VALUES FROM \"prometheus\" WITH KEY = \"worker\"",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "type": "query",
        "name": "domain",
        "label": "Domain",
        "datasource": {
          "type": "influxdb",
          "uid": "${DS}"
        },
        "query": "SHOW TAG VALUES FROM \"prometheus\" WITH KEY = \"domain\"",
        "definition": "SHOW TAG VALUES FROM \"prometheus\" WITH KEY = \"domain\"",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "type": "query",
        "name": "instance",
        "label": "Worker metrics URL",
        "datasource": {
          "type": "influxdb",
          "uid": "${DS}"
        },
        "query": "SHOW TAG VALUES FROM \"prometheus\" WITH KEY = \"url\" WHERE \"wgkex_role\" = 'worker'",
        "definition": "SHOW TAG VALUES FROM \"prometheus\" WITH KEY = \"url\" WHERE \"wgkex_role\" = 'worker'",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Load distribution",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Effective peers vs. weighted target",
      "id": 2,
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* target$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "query": "SELECT last(\"wgkex_broker_worker_effective_peers\") FROM \"prometheus\" WHERE \"worker\" =~ /^$worker$/ AND $timeFilter GROUP BY time($__interval), \"worker\" fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_worker effective"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "query": "SELECT last(\"wgkex_broker_worker_target_peers\") FROM \"prometheus\" WHERE \"worker\" =~ /^$worker$/ AND $timeFilter GROUP BY time($__interval), \"worker\" fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_worker target"
        }
      ],
      "description": "Effective peers (connected + pending assignments) per worker and its share of all peers according to the configured weight. Dashed: target."
    },
