          "query": "SELECT last(\"wgkex_broker_worker_domain_connected_peers\") FROM \"prometheus\" WHERE \"worker\" =~ /^$worker$/ AND \"domain\" =~ /^$domain$/ AND $timeFilter GROUP BY time($__interval), \"worker\", \"domain\" fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_worker $tag_domain"
