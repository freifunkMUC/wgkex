        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "wgkex_broker_worker_domain_online{worker=~\"$worker\", domain=~\"$domain\"}",
          "legendFormat": "{{worker}} {{domain}}",
          "range": true
        }
      ],
      "description": "Online with fresh connected peers metrics for the domain (load_balancing.metrics_max_age)."
    },
    {
      "type": "timeseries",
      "title": "Assignments per worker (per minute)",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
