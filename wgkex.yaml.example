# [broker, worker] The domains that should be accepted by clients and for which matching WireGuard interfaces exist
domains:
  - ffmuc_muc_cty
  - ffmuc_muc_nord
  - ffmuc_muc_ost
  - ffmuc_muc_sued
  - ffmuc_muc_west
  - ffmuc_welt
  - ffwert_city
# [broker, worker] The prefix is trimmed from the domain name and replaced with 'wg-' and 'vx-'
# to calculate the WireGuard and VXLAN interface names
domain_prefixes:
  - ffmuc_
  - ffdon_
  - ffwert_
# [broker] The dict of workers mapping their hostname to their respective weight for weighted peer distribution.
# Workers missing here get the average configured weight (and a warning is logged).
workers:
  gw04.in.ffmuc.net:
    weight: 30
  gw05.in.ffmuc.net:
    weight: 30
  gw06.in.ffmuc.net:
    weight: 20
  gw07.in.ffmuc.net:
    weight: 20
# [broker, worker] Optional: load balancing of peers across the workers. All values below are the defaults.
load_balancing:
  # [broker] Seconds a peer assigned via /api/v2 counts towards the load of the chosen worker
  # until it shows up in the connected peers metric reported by that worker
  pending_assignment_ttl: 300
  # [broker] Minimum seconds an assignment is kept before a metric update may supersede it
  pending_assignment_settle_time: 60
  # [broker] Seconds without a connected peers metric (workers send it every 60s) after which
  # a worker is treated as offline for that domain. 0 disables the check.
  metrics_max_age: 180
  # Active rebalancing: overloaded workers slowly evict peers so they reconnect to underloaded workers,
  # e.g. after a gateway reboot. Must be enabled on the broker and on the workers to have any effect.
  rebalancing:
    # [broker, worker]
    enabled: false
    # [broker, worker] Seconds between rebalancing rounds
    interval: 60
    # [broker] Relative excess over the weighted target that is tolerated without rebalancing
    tolerance: 0.1
    # [broker] Absolute excess (in peers) that is tolerated without rebalancing
    min_excess_peers: 10
    # [broker] Seconds the set of online workers must be unchanged before rebalancing starts
    stable_time: 600
    # [worker] Maximum share of the connected peers evicted per interval (at least 1 peer)
    max_evictions_ratio: 0.01
    # [worker] Seconds before the same peer may be evicted again
    eviction_cooldown: 3600
# [worker] The external hostname of this worker
externalName: gw04.ext.ffmuc.net
# [broker, worker] MQTT connection informations
mqtt:
  broker_url: broker.hivemq.com
  broker_port: 1883
  username: user
  password: SECRET
  keepalive: 5
  tls: False
# [broker]
broker_listen:
  host: 0.0.0.0
  port: 5000
# [broker, worker] Log level of the root logger (DEBUG, INFO, WARNING, ERROR, CRITICAL), defaults to INFO.
# Overrides the root level of logging_config.
log_level: INFO
# [broker, worker] Optional: a full Python logging configuration (dictConfig format)
logging_config:
  formatters:
    standard:
      format: '%(asctime)s,%(msecs)d %(levelname)-8s [%(filename)s:%(lineno)d] %(message)s'
  handlers:
    console:
      class: logging.StreamHandler
      formatter: standard
  root:
    handlers:
      - console
    level: DEBUG
  version: 1
